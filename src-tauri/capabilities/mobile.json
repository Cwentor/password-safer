{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mobile",
  "description": "Capability for Android mobile platform",
  "windows": ["main"],
  "platforms": ["android"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:image:default",
    "core:resources:default",
    "os:default",
    "shell:allow-open",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
